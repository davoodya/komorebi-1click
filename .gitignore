# Releases are built artifacts, not source. Keep the published EXE out of the
# repository — it is distributed via GitHub Releases instead.
releases/*.exe
releases/*.msi
releases/*.zip

# The installer wrapper EXE is likewise a build artifact: scripts/build-exe.ps1
# rebuilds it from scripts/komorebi-install.cs with csc.exe on any dev machine
# (ADR-0004). The SOURCE is tracked; the binary is not.
komorebi-1click-install.exe
install/

# .NET build output for the Admin Dashboard. Never commit these: obj/ holds
# machine-specific generated sources, so a naive recursive scan for *.cs finds
# files that look like project sources but are not.
[Bb]in/
[Oo]bj/

# Build/test scratch that must never be committed.
[Ss]cratch/
[Tt]emp/
*.log

# scripts/ IS the shipped script tree. The old placeholder .gitkeep is gone now
# that scripts/Install-Common.ps1 lives here. Do not ignore this directory.

# cheatsheets/ still carries machine-specific paths (F:\Backups\... references)
# and is NOT publishable until ticket 03's doc-portability pass removes them.
/cheatsheets/

# Editor and OS noise.
.vs/
.idea/
*.user
*.suo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
