{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": null,
  "window_hiding_behaviour": "Cloak",
  "cross_boundary_behaviour": "Monitor",
  "cross_monitor_move_behaviour": "Insert",
  "unmanaged_window_operation_behaviour": "Op",
  "floating_layer_behaviour": "Tile",
  "window_container_behaviour": "Create",
  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "resize_delta": 20,
  "border": true,
  "border_width": 1,
  "border_offset": -1,
  "border_colours": {
    "unfocused": "#2b2b2b",
    "single": "#00e5ff",
    "stack": "#7ee787",
    "monocle": "#f778ba",
    "floating": "#e5c07b",
    "unfocused_locked": "#4a4a4a"
  },
  "animation": {
    "enabled": false
  },
  "mouse_follows_focus": true,
  "ignore_rules": [
