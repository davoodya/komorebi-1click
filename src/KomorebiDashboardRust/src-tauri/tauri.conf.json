{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Komorebi Admin Dashboard",
  "version": "0.1.0",
  "identifier": "ir.davoodya.komorebi-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Komorebi Admin Dashboard",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../KomorebiDashboard/Resources/logo.ico"
    ]
  }
}
