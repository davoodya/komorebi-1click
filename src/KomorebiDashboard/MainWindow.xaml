<Window x:Class="KomorebiDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KomorebiDashboard.Views"
        Title="Komorebi Admin Dashboard"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
  <!--
    Hosts the six tab Views. All it does is place them; every button inside them
    is generated from VerbRegistry, so this window needs no per-verb wiring
    either (ADR-0009 / ADR-0013).
  -->
  <TabControl Margin="8">
    <TabItem Header="Kill and Start"><views:KillStartView /></TabItem>
    <TabItem Header="Restart and Reloading"><views:RestartView /></TabItem>
    <TabItem Header="Settings"><views:SettingsView /></TabItem>
    <TabItem Header="AutoHotkey Scripts"><views:AutoHotkeyView /></TabItem>
    <TabItem Header="Debugging"><views:DebuggingView /></TabItem>
    <TabItem Header="Uninstall and Cleanup"><views:UninstallView /></TabItem>
  </TabControl>
</Window>