<ui:FluentWindow x:Class="KomorebiDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KomorebiDashboard.Views"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="Komorebi Admin Dashboard"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <!--
    D21 BLACK SCREEN FIX: FluentWindow with Mica backdrop requires a non-null,
    opaque Background brush to composite content correctly. Without it, the DWM
    Mica layer renders but WPF content is transparent → black screen.

    ApplicationBackgroundBrush is provided by ThemesDictionary and resolves to
    the correct Dark/Light surface colour. Setting it here ensures content is
    always visible regardless of theme state at startup.

    ExtendsContentIntoTitleBar=True is REQUIRED by FluentWindow when backdrop
    is Mica/Acrylic/Tabbed. Removing it causes InvalidOperationException.
  -->
  <ui:FluentWindow.Background>
    <DynamicResource ResourceKey="ApplicationBackgroundBrush" />
  </ui:FluentWindow.Background>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="Komorebi Admin Dashboard"
                 ShowMinimize="True"
                 ShowMaximize="False"
                 ShowClose="True" />

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="12,8,12,0">
        <TextBlock Text="Komorebi Admin Dashboard" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button x:Name="ThemeToggle"
                Content="Toggle theme"
                HorizontalAlignment="Right"
                Padding="12,5"
                Click="OnToggleTheme"
                ToolTip="Switch between the Dark and Light Fluent themes" />
      </Grid>

      <TabControl Grid.Row="1" Margin="8">
        <TabItem Header="Kill and Start"><views:KillStartView x:Name="KillStartView" /></TabItem>
        <TabItem Header="Restart and Reloading"><views:RestartView x:Name="RestartView" /></TabItem>
        <TabItem Header="Settings"><views:SettingsView x:Name="SettingsView" /></TabItem>
        <TabItem Header="Customization"><views:CustomizationView x:Name="CustomizationView" /></TabItem>
        <TabItem Header="AutoHotkey Scripts"><views:AutoHotkeyView x:Name="AutoHotkeyView" /></TabItem>
        <TabItem Header="Debugging"><views:DebuggingView x:Name="DebuggingView" /></TabItem>
        <TabItem Header="Uninstall and Cleanup"><views:UninstallView x:Name="UninstallView" /></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</ui:FluentWindow>
