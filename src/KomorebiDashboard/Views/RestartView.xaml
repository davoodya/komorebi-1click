<UserControl x:Class="KomorebiDashboard.Views.RestartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <views:TabLayout PageTitle="Restart and Reloading"
                   PageSubtitle="Restart individual components or the whole stack. Each restart freezes the watchdog for the restart window, so nothing races the new session.">
    <ItemsControl ItemsSource="{Binding Rows}"
                  ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />
  </views:TabLayout>
</UserControl>