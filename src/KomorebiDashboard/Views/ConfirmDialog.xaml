<Window x:Class="KomorebiDashboard.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="Confirm"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <!--
    A themed confirmation for actions that cannot be undone (factory reset,
    uninstall, cleanup). Deliberately NOT MessageBox: MessageBox ignores the
    Fluent theme entirely and renders light-on-light in Dark mode, which is the
    one place a stray unreadable panel would appear in the whole app.

    ElevationPromptWindow stays a separate window: ADR-0012 fixes its title and
    its three button labels, and folding it into this generic dialog would have
    to special-case all of that back in.
  -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="HeadingText"
               Style="{DynamicResource K1cPageTitle}"
               Text="Confirm"
               Margin="0,0,0,8" />

    <TextBlock Grid.Row="1" x:Name="MessageText"
               TextWrapping="Wrap"
               FontSize="13"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Margin="0,0,0,20" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <ui:Button x:Name="CancelButton"
                 Content="Cancel"
                 Appearance="Secondary"
                 IsCancel="True"
                 MinWidth="96"
                 Margin="0,0,8,0"
                 Click="OnCancel" />
      <ui:Button x:Name="ConfirmButton"
                 Content="Confirm"
                 Appearance="Primary"
                 MinWidth="120"
                 IsDefault="True"
                 Click="OnConfirm" />
    </StackPanel>
  </Grid>
</Window>