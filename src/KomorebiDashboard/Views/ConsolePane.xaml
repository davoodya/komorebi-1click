<UserControl x:Class="KomorebiDashboard.Views.ConsolePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">
  <!--
    The shared script-output pane: a header, the console itself, and the run's
    status line. One markup file for all seven tabs, so the output surface cannot
    drift between them and a fix here lands everywhere.

    Every binding resolves against the tab's ViewModel (TabViewModelBase), which
    is the inherited DataContext — this control carries no DataContext of its own
    on purpose, so the tabs stay the single source of state.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: what this pane is, how much of the tab it takes, and the two
         knobs that change that. The "Clear" button exists because a long run is
         exactly when the earlier noise becomes unreadable. -->
    <Grid Grid.Row="0" Margin="2,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- The grip: drag it up or down to resize the console. Sits immediately
           above the output, which is the edge it moves, so the pointer does not
           have to travel to a control elsewhere. Cursor=SizeNS and the wider hit
           area come from K1cGrip. -->
      <Border Grid.Column="0" Style="{DynamicResource K1cGrip}"
              x:Name="ResizeGrip"
              Margin="0,0,8,0"
              MouseLeftButtonDown="OnResizeStart"
              MouseMove="OnResizeMove"
              MouseLeftButtonUp="OnResizeEnd"
              ToolTip="Drag to resize the console">
        <!-- Declared inline, not in the style: a Style Child setter would create
             a single shared StackPanel, and these three lines would then belong to
             whichever tab loaded first. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Rectangle Height="1.5" Width="10" RadiusX="0.75" RadiusY="0.75"
                     Fill="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
          <Rectangle Height="1.5" Width="10" RadiusX="0.75" RadiusY="0.75"
                     Fill="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2" />
          <Rectangle Height="1.5" Width="10" RadiusX="0.75" RadiusY="0.75"
                     Fill="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Console"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding ConsoleInfo}"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0" />
      </StackPanel>

      <ui:Button Grid.Column="2" Content="Clear"
                 Command="{Binding ClearOutputCommand}"
                 Appearance="Transparent"
                 Padding="10,3" MinHeight="26" FontSize="11.5"
                 ToolTip="Clear the console" />
    </Grid>

    <TextBox Grid.Row="1"
             x:Name="ConsoleBox"
             Style="{DynamicResource K1cConsole}"
             TextChanged="OnTextChanged"
             Text="{Binding Output, Mode=OneWay}" />

    <!-- Status: the one-line verdict of the last run. -->
    <TextBlock Grid.Row="2" x:Name="StatusText"
               Text="{Binding Status}"
               Margin="2,7,0,0"
               FontSize="12.5"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
  </Grid>
</UserControl>