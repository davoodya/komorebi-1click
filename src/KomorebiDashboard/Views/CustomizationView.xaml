<UserControl x:Class="KomorebiDashboard.Views.CustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">
  <!--
    Customization tab: font size, UI scale, colour scheme, sub-theme.
    All bindings go through CustomizationViewModel. No code-behind logic.

    NOTE (D21 fix): WPF-UI 4.x CardControl does NOT expose a 'Description'
    dependency property. Earlier drafts that set Description="..." failed to
    compile with MC3072. The description text is now rendered as a separate
    TextBlock below each card header, which achieves the same visual result
    without relying on a non-existent API.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">

      <!-- Section: Theme Mode -->
      <TextBlock Text="Theme Mode" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
      <ui:CardControl Header="Dark / Light" Margin="0,0,0,4">
        <ui:Button Content="Toggle Theme"
                   Command="{Binding ToggleThemeCommand}"
                   Appearance="Primary" />
      </ui:CardControl>
      <TextBlock Text="Toggle the overall theme" Opacity="0.7" Margin="0,0,0,12" />

      <!-- Section: Colour Scheme -->
      <TextBlock Text="Colour Scheme" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8" />
      <ui:CardControl Header="Accent Colour" Margin="0,0,0,4">
        <ComboBox ItemsSource="{Binding AvailableSchemes}"
                  SelectedItem="{Binding SelectedScheme, Mode=TwoWay}"
                  MinWidth="160" />
      </ui:CardControl>
      <TextBlock Text="Changes the primary accent used across buttons, cards and highlights"
                 Opacity="0.7" Margin="0,0,0,12" />

      <!-- Section: Sub-Theme / Backdrop -->
      <TextBlock Text="Sub-Theme" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8" />
      <ui:CardControl Header="Window Backdrop" Margin="0,0,0,4">
        <ComboBox ItemsSource="{Binding AvailableBackdrops}"
                  SelectedItem="{Binding SelectedBackdrop, Mode=TwoWay}"
                  MinWidth="160" />
      </ui:CardControl>
      <TextBlock Text="Mica (default), Acrylic, or None for maximum performance"
                 Opacity="0.7" Margin="0,0,0,12" />

      <!-- Section: Typography -->
      <TextBlock Text="Typography" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8" />

      <ui:CardControl Header="Base Font Size" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal">
          <Slider Minimum="10" Maximum="22" Value="{Binding FontSize, Mode=TwoWay}"
                  Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                  Margin="0,0,8,0" />
          <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0}px}"
                     VerticalAlignment="Center" MinWidth="40" />
        </StackPanel>
      </ui:CardControl>
      <TextBlock Text="Adjusts the root font size (default 14)" Opacity="0.7" Margin="0,0,0,8" />

      <ui:CardControl Header="Font Family" Margin="0,0,0,4">
        <ComboBox ItemsSource="{Binding AvailableFonts}"
                  SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                  MinWidth="200" />
      </ui:CardControl>
      <TextBlock Text="Choose the UI typeface" Opacity="0.7" Margin="0,0,0,12" />

      <!-- Section: UI Scale -->
      <TextBlock Text="UI Scale" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8" />
      <ui:CardControl Header="Scale Factor" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal">
          <Slider Minimum="80" Maximum="150" Value="{Binding UiScale, Mode=TwoWay}"
                  Width="200" TickFrequency="5" IsSnapToTickEnabled="True"
                  Margin="0,0,8,0" />
          <TextBlock Text="{Binding UiScale, StringFormat={}{0:F0}%}"
                     VerticalAlignment="Center" MinWidth="45" />
        </StackPanel>
      </ui:CardControl>
      <TextBlock Text="Scales the entire interface (100% = default)" Opacity="0.7" Margin="0,0,0,12" />

      <!-- Reset -->
      <ui:Button Content="Reset to Defaults"
                 Command="{Binding ResetDefaultsCommand}"
                 Appearance="Secondary"
                 Margin="0,16,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
