<UserControl x:Class="KomorebiDashboard.Views.KillStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <views:TabLayout PageTitle="Kill and Start"
                   PageSubtitle="Manage the komorebi, whkd and yasb processes. komorebi and whkd are started and stopped together: whkd must be owned by komorebi or its hotkeys are silently dropped.">
    <ItemsControl ItemsSource="{Binding Rows}"
                  ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />
  </views:TabLayout>
</UserControl>