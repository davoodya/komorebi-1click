<UserControl x:Class="KomorebiDashboard.Views.DebuggingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <views:TabLayout PageTitle="Debugging"
                   PageSubtitle="Diagnostics, monitor recovery and workspace tools. Rows marked READ-ONLY change nothing on the system.">
    <ItemsControl ItemsSource="{Binding Rows}"
                  ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />
  </views:TabLayout>
</UserControl>