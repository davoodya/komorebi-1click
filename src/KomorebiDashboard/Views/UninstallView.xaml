<UserControl x:Class="KomorebiDashboard.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <views:TabLayout PageTitle="Uninstall and Cleanup"
                   PageSubtitle="Remove software components and leftover traces. Both actions need Administrator rights and both ask for confirmation first.">
    <StackPanel>
      <ItemsControl ItemsSource="{Binding Rows}"
                    ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Available scopes" />
      <Border Style="{DynamicResource K1cRow}">
        <TextBlock Style="{DynamicResource K1cRowDescription}"
                   Text="all — komorebi, whkd, YASB and AutoHotkey&#x0a;komorebi-whkd — the window manager and its hotkey daemon only&#x0a;yasb — the status bar only&#x0a;autohotkey — both AutoHotkey versions only" />
      </Border>
    </StackPanel>
  </views:TabLayout>
</UserControl>