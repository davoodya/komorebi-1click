<UserControl x:Class="KomorebiDashboard.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <!--
    About tab, in the same shape as every other tab: a heading and one row per
    fact, with the value on the right.

    It has NO console pane and no Run button anywhere, deliberately: a console
    that is permanently empty reads as "broken", and this tab runs nothing. Every
    value is discovered in-process, so there is nothing to stream.
  -->
  <views:TabLayout PageTitle="About"
                   PageSubtitle="What this Dashboard is, which build is running, and where it lives on disk."
                   ShowConsole="False">
    <StackPanel>

      <!-- Identity -->
      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Product" />
      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0"
                 Source="pack://application:,,,/KomorebiDashboard;component/Resources/logo.ico"
                 Width="56" Height="56"
                 Margin="0,0,16,0"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding ProductName}" Style="{DynamicResource K1cRowTitle}" FontSize="15.5" />
            <TextBlock Text="{Binding Summary}" Style="{DynamicResource K1cRowDescription}" Margin="0,4,10,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Style="{DynamicResource K1cBadge}" Margin="0,0,8,0">
                <TextBlock Text="{Binding Version}" Style="{DynamicResource K1cBadgeText}" />
              </Border>
              <TextBlock Text="{Binding RuntimeDescription}"
                         Style="{DynamicResource K1cRowDescription}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The two paths that answer "which copy am I running?" -->
      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Build" />
      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Executable" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding ExecutablePath}" Style="{DynamicResource K1cRowDescription}"
                       Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Style="{DynamicResource K1cSecondaryButton}"
                       Content="Open Folder"
                       Command="{Binding OpenExecutableFolderCommand}"
                       Margin="0,0,8,0"
                       ToolTip="Show the folder of the running executable" />
            <ui:Button Style="{DynamicResource K1cSecondaryButton}"
                       Content="Copy Version"
                       Command="{Binding CopyVersionCommand}"
                       ToolTip="Copy the version and executable path to the clipboard" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Scripts directory" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding ScriptsPath}" Style="{DynamicResource K1cRowDescription}"
                       Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Settings file" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding SettingsPath}" Style="{DynamicResource K1cRowDescription}"
                       Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Author and links -->
      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Author" />
      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="{Binding Author}" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding AuthorUrl}" Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Style="{DynamicResource K1cSecondaryButton}"
                       Content="Open Website"
                       Command="{Binding OpenUrlCommand}"
                       CommandParameter="{Binding WebsiteUrl}"
                       Margin="0,0,8,0"
                       ToolTip="Open davoodya.ir in the default browser" />
            <ui:Button Style="{DynamicResource K1cSecondaryButton}"
                       Content="Open GitHub"
                       Command="{Binding OpenUrlCommand}"
                       CommandParameter="{Binding RepositoryUrl}"
                       ToolTip="Open the project repository on GitHub" />
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </views:TabLayout>
</UserControl>