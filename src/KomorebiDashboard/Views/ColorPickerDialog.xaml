<Window x:Class="KomorebiDashboard.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="Choose Accent Color"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextOptions.TextFormattingMode="Display">
  <!--
    A picker written from primitives rather than using Wpf.Ui.Controls.ColorPicker.

    That control exists in the pinned 4.3.0 build but exposes no color value and
    no change event (verified by reflection against the shipped DLL), so it is a
    layout shell: using it would mean drawing a picker that cannot report what the
    user picked. Three channel sliders plus a hex box is smaller than a wrapper
    around it and does not depend on a future API.

    The hex box and the sliders are two views of one value and stay in sync both
    ways; see the code-behind.
  -->
  <StackPanel Margin="20">
    <TextBlock Text="Accent Color" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Text="Pick any color for buttons, the selected tab and focus rings."
               Style="{DynamicResource K1cRowDescription}" Margin="0,4,0,14" />

    <!-- Preview: the whole point of a picker is seeing the result before committing. -->
    <Border x:Name="PreviewBorder"
            Height="46" CornerRadius="6" Margin="0,0,0,16"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1">
      <TextBlock x:Name="PreviewText"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontWeight="SemiBold" FontSize="13" />
    </Border>

    <!-- Channels -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Width="18" VerticalAlignment="Center" />
      <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider"
              Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
              TickFrequency="1" Margin="6,2"
              ValueChanged="OnChannelChanged" />
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RedValue" Width="34"
                 TextAlignment="Right" VerticalAlignment="Center" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Width="18" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider"
              Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
              TickFrequency="1" Margin="6,2"
              ValueChanged="OnChannelChanged" />
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GreenValue" Width="34"
                 TextAlignment="Right" VerticalAlignment="Center" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Width="18" VerticalAlignment="Center" />
      <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider"
              Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
              TickFrequency="1" Margin="6,2"
              ValueChanged="OnChannelChanged" />
      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BlueValue" Width="34"
                 TextAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <!-- Hex: the same value as text, so a color can be pasted in exactly. -->
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
      <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ui:TextBox x:Name="HexBox" Width="120"
                  Style="{DynamicResource K1cValueBox}"
                  TextChanged="OnHexChanged"
                  ToolTip="Type a hex color, e.g. #0078D4" />
      <TextBlock Text="Enter a color in the form #RRGGBB"
                 Style="{DynamicResource K1cRowDescription}"
                 VerticalAlignment="Center" Margin="10,0,0,0" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <ui:Button Content="Cancel" Style="{DynamicResource K1cSecondaryButton}"
                 Click="OnCancel" Margin="0,0,8,0" MinWidth="90" />
      <ui:Button Content="Use This Color" Style="{DynamicResource K1cPrimaryButton}"
                 Click="OnAccept" MinWidth="130" />
    </StackPanel>
  </StackPanel>
</Window>