<UserControl x:Class="KomorebiDashboard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <!--
    Layout follows the Customization tab: a heading, then one row per option,
    stacked top to bottom. The startup and config rows come from the registry via
    Rows, so a new verb appears here with no change to this file; the rows around
    them are the ones that need a control the generic template does not provide.
  -->
  <views:TabLayout PageTitle="Settings"
                   PageSubtitle="Startup tasks, configuration export and import, window transparency, and the Dashboard's own preferences.">
    <StackPanel>
      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Startup tasks" />
      <ItemsControl ItemsSource="{Binding StartupRows}"
                    ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />
      <TextBlock Style="{DynamicResource K1cRowDescription}" Margin="2,2,0,0"
                 Text="The logon task runs komorebic start --whkd at RunLevel Highest, so an unelevated window manager cannot manage elevated windows. The watchdog only restarts komorebi when it has actually died." />

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Configuration" />
      <ItemsControl ItemsSource="{Binding ConfigRows}"
                    ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Appearance" />
      <ItemsControl ItemsSource="{Binding AppearanceRows}"
                    ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Dashboard preferences" />
      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Settings file" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding SettingsPath}" Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0" />
          </StackPanel>
          <ui:Button Grid.Column="1" Style="{DynamicResource K1cSecondaryButton}"
                     Content="Open Folder"
                     Command="{Binding OpenSettingsFolderCommand}"
                     ToolTip="Show the folder that holds settings.json" />
        </Grid>
      </Border>

      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Ignore KomorebiDashboard" Style="{DynamicResource K1cRowTitle}" />
            <!-- The explanation is bound from the registry row, not retyped: the
                 same sentence the CLI prints in its help output, so the two
                 cannot drift. -->
            <TextBlock Text="{Binding IgnoreDashboardRow.Help}" Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0" />
          </StackPanel>
          <ui:Button Grid.Column="1" Style="{DynamicResource K1cSecondaryButton}"
                     Content="{Binding IgnoreDashboardRow.ActionLabel}"
                     Command="{Binding RunRowCommand}"
                     CommandParameter="{Binding IgnoreDashboardRow}"
                     MinWidth="130"
                     ToolTip="Write the ignore rule into komorebi.json and hot-reload it" />
        </Grid>
      </Border>

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Reset" />
      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Factory Reset" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0"
                       Text="Restore every Dashboard preference to its default. Does not touch komorebi, whkd, YASB, AutoHotkey, their config, or any scheduled task." />
          </StackPanel>
          <ui:Button Grid.Column="1" Style="{DynamicResource K1cSecondaryButton}"
                     Content="Reset All Settings"
                     Command="{Binding FactoryResetCommand}"
                     MinWidth="170"
                     ToolTip="Ask for confirmation, then restore every preference to its default" />
        </Grid>
      </Border>

      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Cancel Running Command" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding Status}" Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0" />
          </StackPanel>
          <ui:Button Grid.Column="1" Style="{DynamicResource K1cSecondaryButton}"
                     Content="Cancel"
                     Command="{Binding CancelCommand}"
                     MinWidth="110"
                     ToolTip="Kill the running script and its whole process tree" />
        </Grid>
      </Border>
    </StackPanel>
  </views:TabLayout>
</UserControl>