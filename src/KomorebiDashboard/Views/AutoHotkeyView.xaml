<UserControl x:Class="KomorebiDashboard.Views.AutoHotkeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             xmlns:views="clr-namespace:KomorebiDashboard.Views">
  <!--
    AutoHotkey Scripts. Layout follows the Customization tab: one row per action,
    stacked top to bottom.

    The three global rows come first (disable all / enable all / apply), then one
    row per shipped script with a real Disable/Enable choice. The per-script choice
    is not applied until Apply is pressed, because each change spawns a script that
    rewrites AppRunner.vbs — doing that on every click would be three process
    launches per click and a race between them.
  -->
  <views:TabLayout PageTitle="AutoHotkey Scripts"
                   PageSubtitle="Turn the shipped AutoHotkey scripts on or off. Each change rewrites AppRunner.vbs so it survives the next logon, and starts or stops that script's process immediately.">
    <StackPanel>

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="All scripts" />
      <ItemsControl ItemsSource="{Binding AllScriptsRows}"
                    ItemTemplate="{DynamicResource K1cVerbRowTemplate}" />

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Shipped scripts" />
      <ItemsControl ItemsSource="{Binding ScriptRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource K1cRow}" ToolTip="{Binding Description}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" Style="{DynamicResource K1cRowTitle}" />
                    <Border Style="{DynamicResource K1cBadge}" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Hotkey}" Style="{DynamicResource K1cBadgeText}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding StatusText}" Style="{DynamicResource K1cRowDescription}"
                             Margin="0,3,0,0"
                             Foreground="{DynamicResource K1cAccentBrush}" />
                </StackPanel>

                <!-- A real radio pair: the two states are mutually exclusive, and
                     GroupName keeps them so per row without a converter. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton Content="Disable"
                               GroupName="{Binding GroupName}"
                               IsChecked="{Binding IsDisabled, Mode=TwoWay}"
                               Margin="0,0,16,0" />
                  <RadioButton Content="Enable"
                               GroupName="{Binding GroupName}"
                               IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{DynamicResource K1cSectionTitle}" Text="Apply" />
      <Border Style="{DynamicResource K1cRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Apply script states" Style="{DynamicResource K1cRowTitle}" />
            <TextBlock Text="{Binding ApplyHint}" Style="{DynamicResource K1cRowDescription}" Margin="0,2,0,0" />
          </StackPanel>
          <ui:Button Grid.Column="1" Style="{DynamicResource K1cRunButton}"
                     Content="Apply"
                     Command="{Binding ApplyCommand}"
                     MinWidth="150"
                     ToolTip="Apply the chosen state to every changed script, then remember it" />
        </Grid>
      </Border>
    </StackPanel>
  </views:TabLayout>
</UserControl>